// =============================================================================
// Physical Pin Constraints for Sipeed Tang Nano 9K (GW1NR-LV9QN88PC6/I5)
// =============================================================================

// 27 MHz System Clock
IO_LOC  "clk_27m" 52;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// On-board Pushbuttons (1.8V Bank)
IO_LOC  "rst_n" 4;
IO_PORT "rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC  "tare_btn_n" 3;
IO_PORT "tare_btn_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// Eddy Current Probe Drive & SPI ADC Interface (3.3V Bank)
IO_LOC  "coil_drive" 25;
IO_PORT "coil_drive" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "adc_cs_n" 26;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "adc_sclk" 27;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "adc_miso" 28;
IO_PORT "adc_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "buzzer_out" 29;
IO_PORT "buzzer_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// On-board 6 LEDs (1.8V Bank, Active LOW)
IO_LOC  "led_n[0]" 10;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_n[1]" 11;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_n[2]" 13;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_n[3]" 14;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_n[4]" 15;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_n[5]" 16;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS18 DRIVE=8;

